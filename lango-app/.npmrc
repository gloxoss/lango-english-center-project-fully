# ponytail: react-day-picker@8 declares a peer of date-fns ^2 || ^3, but this repo
# runs date-fns ^4.4.0, so a bare `npm ci` aborts. This flag is what the existing
# node_modules was installed with - it is load-bearing, not decoration.
# Set here rather than as a CLI flag so Docker, CI and local installs all agree.
# Upgrade path: react-day-picker v9 drops the date-fns peer, after which delete this.
legacy-peer-deps=true

# This tree is large and includes native builds (better-sqlite3, sqlite3), so a
# cold install runs ~15 min and a single registry stall aborts the whole thing -
# a Docker build here already died on ETIMEDOUT after 17 minutes.
fetch-retries=5
fetch-retry-maxtimeout=120000
fetch-timeout=600000
