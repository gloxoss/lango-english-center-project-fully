# SchoolOS Dynamic Multi-Tenant Caddy Configuration
# Handles automated on-demand TLS for custom school domains (.ma, etc.)

{
    # Global options
    email admin@epioso.com
    
    # On-demand TLS asks the SchoolOS backend if a domain is approved before obtaining Let's Encrypt certs
    on_demand_tls {
        ask http://127.0.0.1:3000/api/platform/caddy-ask
        interval 2m
        burst 5
    }
}

# Main platform domain
schoolos.epioso.com, app.schoolos.ma, schoolos.ma {
    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Catch-all for verified customer domains (on-demand TLS)
:443 {
    tls {
        on_demand
    }

    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
